# Copy this file to .env and fill in your values.
# .env is gitignored so secrets stay off GitHub.

# LLM backend
OLLAMA_DEFAULT_MODEL=gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434

# Mem0 memory backend (self-hosted, all local)
# MEM0_DATA_DIR=~/.jrvs/mem0
# MEM0_EMBEDDING_MODEL=nomic-embed-text
# MEM0_COLLECTION_NAME=jrvs_memories

# Optional integrations
# BRAVE_API_KEY=your_brave_api_key_here
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Google OAuth2 (Gmail, Calendar, Docs, Sheets)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub MCP server
# GITHUB_TOKEN=your_github_token_here

# Slack MCP server + notifications
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_TEAM_ID=
# SLACK_CHANNEL_INBOX=#jarvis-inbox
# SLACK_CHANNEL_CALENDAR=#jarvis-calendar
# SLACK_CHANNEL_RESEARCH=#jarvis-research
# SLACK_CHANNEL_SCHEDULE=#jarvis-schedule
# SLACK_CHANNEL_ALERTS=#jarvis-alerts
# SLACK_CHANNEL_GENERAL=#jarvis-general
# SLACK_ROUTE_CONFIDENCE=0.65
